# If you want Electrin to appear in a Linux app launcher ("start menu"), install this by doing:
# sudo desktop-file-install electrum.desktop
# Note: This assumes $HOME/.local/bin is in your $PATH

[Desktop Entry]
Comment=Lightweight Rincoin Client
Exec=electrin %u
GenericName[en_US]=Rincoin Wallet
GenericName=Rincoin Wallet
Icon=electrum
Name[en_US]=Electrin Rincoin Wallet
Name=Electrin Rincoin Wallet
Categories=Finance;Network;
StartupNotify=true
StartupWMClass=electrin
Terminal=false
Type=Application
MimeType=x-scheme-handler/rincoin;x-scheme-handler/lightning;
Actions=Testnet;
Keywords=crypto;currency;RIN

[Desktop Action Testnet]
Exec=electrin --testnet %u
Name=Testnet mode
